<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.com.rivio</groupId>
  <artifactId>magediff</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>magediff</name>
  <description>Comparador e merge de dois arquivos (Swing, sem dependências)</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!--
    O alinhamento vem do JGit (HistogramDiff) — o mesmo motor de diff que uma
    implementação real do Git usa. Só o pacote org.eclipse.jgit.diff é usado; o
    resto do JGit vem junto porque é um artefato único. A UI é Swing, do JDK.
    `./run.sh` resolve as dependências uma vez para target/lib e depois compila
    com javac puro.

    slf4j-nop existe para o JGit não imprimir "No SLF4J providers were found"
    no console: ele registra um logger, e sem provider a mensagem vai pro stderr
    de um app gráfico, onde ninguém a lê e todo mundo estranha.
  -->
  <dependencies>
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <version>6.10.0.202406032230-r</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.13</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>br.com.rivio.magediff.MageDiffApp</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!--
          Fat jar: com dependência externa, `java -jar` sem shade quebraria em
          NoClassDefFoundError. O app é uma ferramenta que se copia para outra
          máquina, então um jar que se basta vale mais que um jar menor.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <!--
                    Os jars do JGit são ASSINADOS. Copiar META-INF/*.SF e as
                    chaves para dentro do fat jar faz a JVM recusar o jar com
                    "Invalid signature file digest" — a assinatura não vale mais
                    depois que o conteúdo foi remontado.
                  -->
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- JGit descobre implementações por ServiceLoader; sem juntar
                     os META-INF/services, o que sobrevive é o último a entrar. -->
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>br.com.rivio.magediff.MageDiffApp</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
          Os testes são um main() (EngineSmokeTest), não JUnit — surefire não tem
          provider para rodá-los e tentaria interpretá-los pelo sufixo do nome.
          Eles são compilados normalmente e executados por `./run.sh test`.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
